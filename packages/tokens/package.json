{
  "name": "@trade/tokens",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Design tokens for @trade/ui — compiles tokens.json into static CSS custom properties and typed TS.",
  "main": "./dist/tokens.cjs",
  "module": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.ts": "./dist/tokens.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build-tokens.mjs",
    "prepack": "node ../../scripts/copy-licenses.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trade/ui.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT OR Apache-2.0"
}
